{
  "name": "sql-sensi",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Natural Language SQL & Data Analysis Desktop Assistant",
  "author": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:next\" \"pnpm dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "pnpm build:electron-ts && wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "dev:electron:watch": "concurrently \"tsc --project tsconfig.electron.json --watch\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build:electron-ts": "tsc --project tsconfig.electron.json",
    "build": "next build",
    "build:app": "pnpm build:electron-ts && pnpm build && electron-builder",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:security": "jest --testPathPattern=tests/security"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",

    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "lucide-react": "^0.395.0",
    "clsx": "^2.1.0"
  },
  "devDependencies": {

    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "build": {
    "appId": "com.sqlsensi.app",
    "productName": "SQL Sensi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
