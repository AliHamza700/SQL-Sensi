{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "electron",
    "rootDir": ".",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "electron/src/**/*.ts",
    "src/config/ipc-channels.ts"
  ],
  "exclude": [
    "node_modules",
    "electron/main.js",
    "electron/preload.js"
  ]
}
