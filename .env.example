# ──────────────────────────────────────────────────────────────
# SQL-Sensi Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any real credentials to Git.
# ──────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=SQL Sensi
NEXT_PUBLIC_APP_VERSION=0.1.0

# ─── AI Provider ──────────────────────────────────────────────
# Select the active provider: "gemini" | "openai" | "local"
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (if using OpenAI provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Local LLM (Ollama or similar)
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# ─── Authentication ───────────────────────────────────────────
# JWT secret — use a long random string in production
AUTH_JWT_SECRET=change_this_to_a_long_random_secret_in_production
AUTH_JWT_EXPIRES_IN=7d

# ─── Database (App metadata storage) ─────────────────────────
# Path for storing conversation history and user data
APP_DATA_DIR=./data

# ─── Query Engine ─────────────────────────────────────────────
# Max rows returned per query (prevents UI from crashing on huge results)
QUERY_MAX_ROWS=10000

# Query timeout in milliseconds
QUERY_TIMEOUT_MS=30000

# ─── Upload ───────────────────────────────────────────────────
# Max SQLite file size in bytes (default: 500MB)
UPLOAD_MAX_SIZE_BYTES=524288000
UPLOAD_DIR=./uploads
